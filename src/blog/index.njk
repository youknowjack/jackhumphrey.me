---
layout: base.njk
title: You Know Jack
---
<p class="page-title">You Know Jack</p>

{% if collections.posts.length %}
<ul class="post-list">
  {% for post in collections.posts %}
  <li class="post-item">
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="post-meta">{{ post.date | date("MMMM d, yyyy") }}</p>
  </li>
  {% endfor %}
</ul>
{% else %}
<p>No posts yet.</p>
{% endif %}
